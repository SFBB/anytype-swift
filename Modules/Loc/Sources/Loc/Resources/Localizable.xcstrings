    "Auth.JoinFlow.Key.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "يحل محل اسم المستخدم وكلمة المرور. احتفظ به آمنًا - أنت تتحكم في بياناتك. يمكنك العثور على هذا المفتاح لاحقًا في إعدادات التطبيق."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It replaces login and password. Keep it safe — you control your data. You can find this Key later in app settings."
