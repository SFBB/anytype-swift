        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Le mode local uniquement est une fonctionnalité expérimentale et n’offre aucun avantage en matière de sécurité. Veuillez l'utiliser à vos propres risques, car une perte de données peut survenir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mode Hanya-Lokal masih bersifat eksperimental dan tidak memberikan keuntungan keamanan apa pun. Hati-hati dalam penggunaannya karena kehilangan data dapat terjadi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
