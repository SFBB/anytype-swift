          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Giá trị của mạng chúng tôi lớn hơn tổng các thành phần của nó. Tư cách hội viên của bạn giữ vững cơ sở cho sự phát triển của nó, chống trụ cho mạng lưới này."
