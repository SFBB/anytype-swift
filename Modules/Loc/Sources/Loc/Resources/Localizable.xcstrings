    "MembershipServiceError.invalidBillingIdFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Internal problem with billing format, we are working on this. Try again later or contact support."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Унутраная праблема з фарматам аплаты, мы працуем над гэтым. Паўтарыце спробу пазней або звярніцеся ў службу падтрымкі."
          }
