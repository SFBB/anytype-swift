    "SpaceShare.Join.Info" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "بمجرد موافقة مالك المساحة على طلبك، ستنضم إلى المساحة بحقوق الوصول التي حددها المالك."
